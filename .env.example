# ============================
# OKX API
# ============================
OKX_BASE_URL=https://www.okx.com

OKX_API_KEY=YOUR_OKX_API_KEY
OKX_SECRET_KEY=YOUR_OKX_SECRET_KEY
OKX_PASSPHRASE=YOUR_OKX_PASSPHRASE

# Demo trading
OKX_DEMO=true
AUTO_TRADE=true

# ============================
# TRADING SETTINGS
# ============================
BAR=5m
TREND_BAR=1H

# Margin per trade
MARGIN_USDT=10

# $10 margin x 3x = approximately $30 position
LEVERAGE=3

# Isolated margin
TD_MODE=isolated

# ============================
# INITIAL SL / TP
# ============================
SL_PERCENT=0.46
TP_PERCENT=0.80

# ============================
# STEP PROFIT PROTECTION
# ============================
# When profit reaches 0.50%, move protection forward
STEP_TRIGGER_PCT=0.50

# When profit reaches 0.35%, move SL to break-even
BREAK_EVEN_TRIGGER_PCT=0.35

# Lock approximately 0.25% beyond entry (fee-corrected)
BREAK_EVEN_OFFSET_PCT=0.25

# ============================
# FEE MODEL
# ============================
# Per-side fee rate (0.06% x 2 sides = 0.12% real round-trip cost)
FEE_RATE_PER_SIDE=0.0006

# Reserved calculation buffer
FEE_BUFFER_USDT=0.13

# ============================
# SR (SUPPORT/RESISTANCE) DETECTION
# ============================
SR_ATR_MULT=1.3
SR_PCT=0.10

# ============================
# STRATEGY
# ============================
POLL_SECONDS=20

# Minimum score for meme coins
MIN_SCORE=7

# Higher-quality threshold for major coins
MAJOR_MIN_SCORE=8

ADX_MIN=14
VOLUME_MULT=0.80
ATR_MIN_PCT=0.05

# ============================
# SYMBOLS
# ============================
SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP,SOL-USDT-SWAP,SHIB-USDT-SWAP,FIL-USDT-SWAP,NEAR-USDT-SWAP,ICP-USDT-SWAP,XAU-USDT-SWAP
