OKX_API_KEY=YOUR_DEMO_API_KEY
OKX_SECRET_KEY=YOUR_DEMO_SECRET_KEY
OKX_PASSPHRASE=YOUR_DEMO_PASSPHRASE

OKX_DEMO=true
OKX_BASE_URL=https://www.okx.com

BAR=5m
TREND_BAR=15m

RSI_FAST=14
RSI_SLOW=100
EMA_PERIOD=20

EMA_MODE=true
EMA_BUY_RSI_MAX=55
EMA_SELL_RSI_MIN=45

USE_ADX=true
ADX_PERIOD=14
ADX_MIN=18

USE_VOLUME=true
VOLUME_PERIOD=20
VOLUME_MULT=0.8

USE_ATR=true
ATR_PERIOD=14
ATR_MIN_PCT=0.05

USE_15M_TREND=true

SL_PERCENT=0.4
TP_PERCENT=0.8

MARGIN_USDT=20
LEVERAGE=5
TD_MODE=isolated

SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP

POLL_SECONDS=15
PORT=8080
