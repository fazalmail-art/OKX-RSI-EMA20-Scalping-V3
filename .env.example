# =========================================================
# OKX API
# =========================================================

OKX_BASE_URL=https://www.okx.com

OKX_API_KEY=YOUR_OKX_API_KEY
OKX_SECRET_KEY=YOUR_OKX_SECRET_KEY
OKX_PASSPHRASE=YOUR_OKX_PASSPHRASE

# Demo trading
OKX_DEMO=true
AUTO_TRADE=true


# =========================================================
# TRADING SETTINGS
# =========================================================

BAR=5m
TREND_BAR=15m

# Margin per trade
MARGIN_USDT=10

# 10 USDT margin x 3 leverage = approximately 30 USDT position
LEVERAGE=3

# IMPORTANT: isolated margin
TD_MODE=isolated


# =========================================================
# INITIAL SL / TP
# =========================================================

SL_PERCENT=0.4
TP_PERCENT=0.8


# =========================================================
# BREAK-EVEN / TRAILING
# =========================================================

BREAK_EVEN_TRIGGER_PCT=0.30
BREAK_EVEN_OFFSET_PCT=0.05

TRAIL_START_PCT=0.50
TRAIL_DISTANCE_PCT=0.30

PROTECTION_RETRY_SECONDS=5


# =========================================================
# STRATEGY
# =========================================================

POLL_SECONDS=20
MIN_SCORE=7

ADX_MIN=18
VOLUME_MULT=0.8
ATR_MIN_PCT=0.05


# =========================================================
# SYMBOLS
# =========================================================

SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP,SOL-USDT-SWAP,SHIB-USDT-SWAP,XAU-USDT-SWAP
