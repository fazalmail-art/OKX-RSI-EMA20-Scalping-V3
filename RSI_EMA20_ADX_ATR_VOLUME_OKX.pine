//@version=6
indicator("RSI + EMA20 + ADX + ATR + Volume Scalping", shorttitle="Scalp V3", overlay=true, max_labels_count=500)

rsi14 = ta.rsi(close, 14)
rsi100 = ta.rsi(close, 100)
ema20 = ta.ema(close, 20)

adx = ta.adx(14)
atr = ta.atr(14)
atrPct = atr / close * 100
volAvg = ta.sma(volume, 20)

slPct = input.float(0.4, "SL %", step=0.1)
tpPct = input.float(0.8, "TP %", step=0.1)

adxMin = input.float(18, "ADX minimum", step=1)
volMult = input.float(0.8, "Volume minimum", step=0.1)
atrMinPct = input.float(0.05, "ATR minimum %", step=0.01)

useEMA = input.bool(true, "Enable EMA20")
use15 = input.bool(true, "Use 15m trend confirmation")

buyRsiMax = input.float(55, "EMA Buy RSI maximum")
sellRsiMin = input.float(45, "EMA Sell RSI minimum")

rsiBuy = ta.crossover(rsi14, rsi100)
rsiSell = ta.crossunder(rsi14, rsi100)

emaBuy = useEMA and not rsiBuy and close > ema20 and close[1] <= ema20[1] and rsi14 <= buyRsiMax
emaSell = useEMA and not rsiSell and close < ema20 and close[1] >= ema20[1] and rsi14 >= sellRsiMin

trend15 = request.security(syminfo.tickerid, "15", close > ta.ema(close, 20) ? 1 : -1)

filtersOK = adx >= adxMin and volume >= volAvg * volMult and atrPct >= atrMinPct

buy = (rsiBuy or emaBuy) and filtersOK and (not use15 or trend15 == 1)
sell = (rsiSell or emaSell) and filtersOK and (not use15 or trend15 == -1)

buySL = close * (1 - slPct / 100)
buyTP = close * (1 + tpPct / 100)

sellSL = close * (1 + slPct / 100)
sellTP = close * (1 - tpPct / 100)

plot(ema20, "EMA 20", color=color.orange, linewidth=2)

plotshape(
     buy,
     title="BUY",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     size=size.small,
     text="BUY"
)

plotshape(
     sell,
     title="SELL",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small,
     text="SELL"
)

if buy
    label.new(
         bar_index,
         low,
         "BUY\nEntry: " + str.tostring(close, "#.##") +
         "\nSL: " + str.tostring(buySL, "#.##") +
         "\nTP: " + str.tostring(buyTP, "#.##") +
         "\nADX: " + str.tostring(adx, "#.##"),
         style=label.style_label_up,
         color=color.new(color.green, 65),
         textcolor=color.white,
         size=size.small
    )

if sell
    label.new(
         bar_index,
         high,
         "SELL\nEntry: " + str.tostring(close, "#.##") +
         "\nSL: " + str.tostring(sellSL, "#.##") +
         "\nTP: " + str.tostring(sellTP, "#.##") +
         "\nADX: " + str.tostring(adx, "#.##"),
         style=label.style_label_down,
         color=color.new(color.red, 65),
         textcolor=color.white,
         size=size.small
    )

alertcondition(buy, "BUY", "RSI/EMA20 BUY")
alertcondition(sell, "SELL", "RSI/EMA20 SELL")
